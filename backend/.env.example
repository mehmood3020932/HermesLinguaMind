# ============================================================
# HERMES LINGUAMIND BACKEND — PRODUCTION ENVIRONMENT CONFIG
# Phase 3 — Production Ready
# ============================================================

# --- Application Settings ---
APP_NAME=HermesLinguaMind
APP_VERSION=3.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- API Gateway ---
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
API_GATEWAY_WORKERS=4

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://hermes:strong_password@postgres:5432/hermes_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_POOL_SIZE=50
REDIS_SOCKET_TIMEOUT=5

# --- Message Queue (RabbitMQ / Redis as broker) ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=4

# --- Authentication ---
SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Providers ---
FREELLMAPI_KEY=your-freellmapi-key-here
FREELLMAPI_BASE_URL=https://api.freellmapi.com/v1
FREELLMAPI_TIMEOUT=30
FREELLMAPI_MAX_RETRIES=3

# ============================================================
# HUGGING FACE — free-tier inference for heavier open-weight models
# Get a free token: https://huggingface.co/settings/tokens
# ============================================================
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct

# ============================================================
# GOOGLE COLAB — optional extra free heavy-model capacity, one entry per
# Google account's notebook tunnel. HONEST CAVEAT: free Colab sessions
# disconnect after idle time and have a hard runtime ceiling, and this
# is best-effort burst capacity, NOT a reliable always-on tier — Ollama
# (below) is the tier that's actually guaranteed to be there.
# Run e.g. text-generation-webui with `--api --extension openai` in the
# notebook, tunnel it with ngrok/cloudflared, and paste the public URLs
# here comma-separated:
#   COLAB_ENDPOINTS=https://acct1.ngrok-free.app/v1,https://acct2.ngrok-free.app/v1
# Leave empty to disable this tier entirely (default).
# ============================================================
COLAB_ENDPOINTS=
COLAB_API_KEY=colab
COLAB_MODEL=auto

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TIMEOUT=60
# Lightweight local model auto-pulled by the `ollama_init` container on
# `docker compose up`. Change this + re-run compose to switch models —
# `ollama pull` is a no-op if it's already downloaded.
#   qwen2.5:0.5b  ~400MB  (smallest, default — good for CPU-only boxes)
#   llama3.2:1b   ~1.3GB  (balanced quality/size)
#   phi3:mini     ~2.3GB  (better quality, needs more RAM)
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_FALLBACK_MODEL=qwen2.5:0.5b

# ============================================================
# EMAIL SERVICE (open-source — any SMTP server, no paid API)
# Leave SMTP_HOST empty for local dev: emails are written as .eml files
# to the email_outbox volume instead of being sent.
# Free self-hosted options: Mailpit/MailHog (dev), Postfix (prod),
# or a free-tier SMTP from your own mail provider.
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@linguamax.local
EMAIL_FROM_NAME=LinguaMax

# ============================================================
# NOTIFICATION SERVICE (open-source — Web Push via VAPID, an open
# W3C/IETF standard; no Firebase/OneSignal/paid push provider).
# Generate a keypair once with: `pip install pywebpush && vapid --gen`
# ============================================================
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@linguamax.local

# Provider fallback order (comma-separated). Ollama first so the stack
# works fully offline / with zero API keys out of the box — the other
# providers only kick in if you add keys above.
LLM_PROVIDER_PRIORITY=ollama,freellmapi

# --- TTS Configuration ---
TTS_DEFAULT_ENGINE=piper
TTS_PIPER_MODEL_PATH=/models/piper
TTS_COQUI_MODEL_PATH=/models/coqui
TTS_MMS_MODEL_PATH=/models/mms
TTS_MAX_TEXT_LENGTH=5000

# --- STT Configuration ---
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_LANGUAGE=en
STT_BEAM_SIZE=5

# --- Pronunciation Scoring ---
PRONUNCIATION_MODEL=wav2vec2-large-960h
PRONUNCIATION_DEVICE=cpu
PRONUNCIATION_CONFIDENCE_THRESHOLD=0.6

# --- Coin Economy ---
COIN_MAX_DAILY_EARN=500
COIN_FRAUD_THRESHOLD=3.0
COIN_LEDGER_RETENTION_DAYS=365

# --- Social Exchange ---
SOCIAL_MIN_AGE=13
SOCIAL_MATCHING_ENABLED=true
SOCIAL_REPORT_COOLDOWN_HOURS=24

# --- Anti-Fraud ---
ANTIFRAUD_RATE_WINDOW_MINUTES=60
ANTIFRAUD_MAX_EARNINGS_PER_WINDOW=200
ANTIFRAUD_MULTI_ACCOUNT_IP_THRESHOLD=5

# --- Observability (Prometheus/Grafana) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=hermes-backend
METRICS_ENABLED=true
TRACING_ENABLED=true

# --- Security ---
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=150
SSL_CERT_PATH=/certs/server.crt
SSL_KEY_PATH=/certs/server.key

# --- Backup / S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=hermes-backups
S3_REGION=us-east-1
BACKUP_SCHEDULE=0 2 * * *

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=hermes

# --- WebRTC / Live Conversation ---
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=

# --- Content Generation ---
CONTENT_BATCH_SIZE=100
CONTENT_TIER1_REVIEW_REQUIRED=true
CONTENT_MAX_QUEUE_SIZE=1000

# --- Language Expansion ---
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh,ar,hi,ru,tr,pl,nl,sv,da,no,fi
DEFAULT_LANGUAGE=en

# --- Kubernetes (Optional) ---
K8S_NAMESPACE=hermes-production
K8S_REPLICAS=3
K8S_RESOURCE_CPU_REQUEST=500m
K8S_RESOURCE_CPU_LIMIT=2000m
K8S_RESOURCE_MEMORY_REQUEST=1Gi
K8S_RESOURCE_MEMORY_LIMIT=4Gi

# --- Phase 4: Hermes Orchestrator ---
# (downstream service URLs are pre-wired in docker-compose.yml via container
# DNS names; override here only if running services outside Docker)
