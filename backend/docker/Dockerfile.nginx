# Tiny public entrypoint: nginx:alpine (~40MB) serves the static frontend
# and reverse-proxies everything else to the unified adapter on :8080.
# This is the ONE port (:80) end users/clients actually talk to.
FROM nginx:1.31-alpine

RUN rm -f /etc/nginx/conf.d/default.conf

COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY frontend/ /usr/share/nginx/html/app/

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O- http://127.0.0.1:80/health || exit 1
